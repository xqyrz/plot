@PACKAGE_INIT@

# 声明 Qt 依赖：find_package(qView) 会同时拉入所需的 Qt 模块
include(CMakeFindDependencyMacro)
find_dependency(QT NAMES Qt6 Qt5 REQUIRED COMPONENTS Core Gui Network Widgets Svg)
find_dependency(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Core Gui Network Widgets Svg)

# 加载导出的目标 qView::qView
include("${CMAKE_CURRENT_LIST_DIR}/qViewTargets.cmake")

check_required_components(qView)
