# =============================================================================
# Object build statements for EXECUTABLE target writer


#############################################
# Order-only phony target for writer

build cmake_object_order_depends_target_writer: phony || .

build examples/writer/CMakeFiles/writer.dir/writer.cpp.obj: CXX_COMPILER__writer_unscanned_Debug F$:/lib/ELFIO/examples/writer/writer.cpp || cmake_object_order_depends_target_writer
  DEP_FILE = examples\writer\CMakeFiles\writer.dir\writer.cpp.obj.d
  FLAGS = -g -std=gnu++17 -fdiagnostics-color=always
  INCLUDES = -IF:/lib/ELFIO
  OBJECT_DIR = examples\writer\CMakeFiles\writer.dir
  OBJECT_FILE_DIR = examples\writer\CMakeFiles\writer.dir


# =============================================================================
# Link build statements for EXECUTABLE target writer


#############################################
# Link the executable examples\writer\writer.exe

build examples/writer/writer.exe: CXX_EXECUTABLE_LINKER__writer_Debug examples/writer/CMakeFiles/writer.dir/writer.cpp.obj
  FLAGS = -g
  LINK_LIBRARIES = -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = examples\writer\CMakeFiles\writer.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = examples\writer\writer.exe
  TARGET_IMPLIB = examples\writer\libwriter.dll.a
  TARGET_PDB = writer.exe.dbg


#############################################
# Utility command for package

build examples/writer/CMakeFiles/package.util: CUSTOM_COMMAND examples/writer/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\lib\ELFIO\cmake-build-debug && "D:\Program Files\JetBrains\CLion 2025.1.1\bin\cmake\win\x64\bin\cpack.exe" --config ./CPackConfig.cmake"
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build examples/writer/package: phony examples/writer/CMakeFiles/package.util


#############################################
# Utility command for package_source

build examples/writer/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\lib\ELFIO\cmake-build-debug && "D:\Program Files\JetBrains\CLion 2025.1.1\bin\cmake\win\x64\bin\cpack.exe" --config ./CPackSourceConfig.cmake F:/lib/ELFIO/cmake-build-debug/CPackSourceConfig.cmake"
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build examples/writer/package_source: phony examples/writer/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build examples/writer/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\lib\ELFIO\cmake-build-debug\examples\writer && "D:\Program Files\JetBrains\CLion 2025.1.1\bin\cmake\win\x64\bin\cmake.exe" -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build examples/writer/edit_cache: phony examples/writer/CMakeFiles/edit_cache.util


#############################################
